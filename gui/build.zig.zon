.{
    .name = .nullclaw_gui,
    .version = "0.1.0",
    .fingerprint = 0x66b7e671533b81be,
    // nanoui is a Zig 0.17 desktop UI toolkit (native UI on the GPU).
    // Both binaries build with Zig 0.17, and this GUI links the `nullclaw`
    // runtime as a module rather than driving a separate program.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // The runtime the window links. The GUI calls into this library for
        // chat, the gateway and most data pages; it needs no nullclaw on PATH
        // for those.
        .nullclaw = .{
            .path = "..",
        },
        .nanoui = .{
            .url = "git+https://github.com/justrach/nanoui#v0.13.0",
            .hash = "nanoui-0.13.0-we0KMd1-MQBzJq1VU59oWYKF3KHhSYPj8_qjVe2icq_e",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
